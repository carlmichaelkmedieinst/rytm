NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Public https origin for the presenter QR. No trailing slash.
# Example: https://rytm-demo.vercel.app
# Leave empty until the demo is deployed. Localhost is rejected.
NEXT_PUBLIC_DEMO_BASE_URL=

# Server only. At least 24 characters. Do not use the NEXT_PUBLIC_ prefix.
# The presenter types this code at /demo/backstage. It is not stored in the browser.
# Generate it locally, set the same value in the Vercel Production environment,
# and store only the SHA-256 hex digest in demo_control.access_secret_hash.
# Do not commit the code or the digest. Do not print them into logs.
#
# PowerShell, run locally and keep the output off screen and out of Git:
# $bytes = New-Object byte[] 32
# [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes)
# $secret = [Convert]::ToBase64String($bytes).TrimEnd('=').Replace('+','A').Replace('/','b')
# $hash = [Convert]::ToHexString([Security.Cryptography.SHA256]::HashData([Text.Encoding]::UTF8.GetBytes($secret))).ToLower()
DEMO_ACCESS_SECRET=
