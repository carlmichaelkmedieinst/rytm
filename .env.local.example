NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Public https origin for the presenter QR. No trailing slash.
# Example: https://rytm-demo.vercel.app
# Leave empty until the demo is deployed. Localhost is rejected.
NEXT_PUBLIC_DEMO_BASE_URL=

# Server only. At least 24 characters. Do not use the NEXT_PUBLIC_ prefix.
# Store the SHA-256 hex digest of the same value in demo_control.access_secret_hash
# before /api/demo/backstage or /api/demo/reset will run.
DEMO_ACCESS_SECRET=
